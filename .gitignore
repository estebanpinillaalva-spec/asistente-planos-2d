# Archivos temporales y de bloqueo de SolidWorks
~$*
*.swlck
*.swBackUp
*.bak

# Modelos del banco de pruebas. Se excluyen por PESO (binarios CAD que cambian
# enteros en cada guardado), no por confidencialidad: son piezas de trabajos
# universitarios de Esteban y no hay material confidencial. Los resultados
# derivados (capturas, DXF, PDF) sí se pueden publicar en Fase 4.
banco-de-pruebas/*
!banco-de-pruebas/README.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# Salidas locales
*.log
notas/clasificacion-planas.csv

# Biblioteca de conocimiento en Obsidian — copia descompuesta de los docs para
# consultas con menos tokens. Privada por ahora; decidir en Fase 4 si se publica.
biblioteca/

# Config del vault de Obsidian (workspace/appearance locales, no aporta al repo)
.obsidian/
