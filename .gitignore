# Archivos temporales y de bloqueo de SolidWorks
~$*
*.swlck
*.swBackUp
*.bak

# Modelos reales del banco de pruebas — pueden ser piezas confidenciales del trabajo.
# Si en el futuro decides publicar alguna (pieza propia, sin IP de terceros), quita su exclusión.
banco-de-pruebas/*
!banco-de-pruebas/README.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# Salidas locales
*.log

# Biblioteca de conocimiento en Obsidian — copia descompuesta de los docs para
# consultas con menos tokens. Privada por ahora; decidir en Fase 4 si se publica.
biblioteca/

# Config del vault de Obsidian (workspace/appearance locales, no aporta al repo)
.obsidian/
